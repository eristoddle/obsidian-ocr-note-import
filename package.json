{
  "name": "obsidian-notebook-ocr",
  "version": "1.0.12",
  "description": "Process handwritten field notebook images using OCR and intelligently import extracted text into Obsidian notes",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "vitest --run",
    "test:watch": "vitest",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "release": "npm version patch && git push && git push --tags"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "ocr",
    "notebook",
    "handwriting"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^16.11.6",
    "@typescript-eslint/eslint-plugin": "5.29.0",
    "@typescript-eslint/parser": "5.29.0",
    "@vitest/ui": "^4.0.13",
    "builtin-modules": "3.3.0",
    "esbuild": "0.17.3",
    "fast-check": "^3.22.0",
    "jsdom": "^27.2.0",
    "obsidian": "latest",
    "tslib": "2.4.0",
    "typescript": "4.7.4",
    "vitest": "^4.0.13"
  },
  "dependencies": {
    "obsidian-daily-notes-interface": "^0.9.4",
    "tesseract.js": "^4.1.1"
  }
}
